<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Seed Students</title>
  <style>body{font-family:Arial;padding:18px} .btn{background:#2563eb;color:#fff;padding:8px 10px;border-radius:6px;border:none}</style>
</head>
<body>
  <h2>Seed Random Students (Admin)</h2>
  <form id="seedForm">
    <label>Count: <input type="number" id="count" value="10" min="1" max="200"></label>
    <label style="margin-left:12px">Department: <input id="dept" value="Computer Science"></label>
    <label style="margin-left:12px">Semester: <input id="sem" type="number" value="1" min="1" max="8"></label>
    <button type="button" id="seedBtn" class="btn">Seed</button>
  </form>
  <div id="result" style="margin-top:12px"></div>
  <script>
    document.getElementById('seedBtn').addEventListener('click', async ()=>{
      const count = parseInt(document.getElementById('count').value,10)||10;
      const dept = document.getElementById('dept').value.trim();
      const sem = parseInt(document.getElementById('sem').value,10)||1;
      const res = await fetch('/admin/seed-students',{method:'POST',headers:{'Content-Type':'application/json'},body: JSON.stringify({ count, department: dept, semester: sem })});
      const j = await res.json(); if(j.success){ document.getElementById('result').innerText = `Created ${j.created.length} students.`; } else { document.getElementById('result').innerText = 'Failed: '+(j.message||''); }
    });
  </script>
</body>
</html>
