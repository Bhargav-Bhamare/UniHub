<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:Arial;background:#f3f4f6;padding:18px}
    .card{background:#fff;padding:12px;border-radius:6px;margin-bottom:8px}
    .muted{color:#6b7280}
    .btn{background:#2563eb;color:#fff;padding:6px 8px;border-radius:4px;text-decoration:none}
  </style>
  </head>
<body>
  <h2>Notifications</h2>
  <p class="muted">Showing recent notices for <strong><%= user && user.name %></strong></p>
  <% if (!notifications || notifications.length === 0) { %>
    <div class="card">No notifications</div>
  <% } else { %>
    <% notifications.forEach(n => { %>
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div>
            <strong><%= n.title %></strong>
            <div class="muted"><%= n.type %> · <%= new Date(n.createdAt).toLocaleString() %></div>
          </div>
          <div>
            <% if (!n.isRead) { %>
              <button class="btn" onclick="markRead('<%= n._id %>')">Mark read</button>
            <% } else { %>
              <span class="muted">Read</span>
            <% } %>
          </div>
        </div>
        <p style="margin-top:8px"><%= n.message %></p>
      </div>
    <% }) %>
  <% } %>

  <script>
    function markRead(id){ fetch('/api/notifications/'+id+'/read',{method:'POST'}).then(r=> r.ok ? location.reload() : alert('Failed')); }
  </script>
</body>
</html>
