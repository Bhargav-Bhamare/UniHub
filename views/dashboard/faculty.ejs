<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:Tahoma, Geneva, sans-serif;background:#f3f4f6;color:#222}
    .app{display:flex;min-height:100vh}
    .sidebar{width:220px;background:#0b1220;color:#fff;padding:18px}
    .logo{margin-bottom:14px;display:flex;align-items:center;gap:8px}
    .site-logo{height:32px;width:auto;display:inline-block}
    .logo-text{font-weight:700;color:#fff}
    .main{flex:1;padding:18px}
    .topbar{display:flex;justify-content:space-between;align-items:center;background:#fff;padding:10px;border-radius:6px;margin-bottom:12px}
    .card{background:#fff;padding:12px;border-radius:6px;margin-bottom:12px}
    .muted{color:#6b7280}
    table{width:100%;border-collapse:collapse}
    th,td{padding:8px;border-bottom:1px solid #eef2f7}
    .btn{background:#10b981;color:#fff;padding:6px 8px;border-radius:4px;text-decoration:none}
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <div class="logo"><img src="/logo.png" alt="UniHub" class="site-logo"><span class="logo-text">UniHub - Faculty</span></div>
      <nav class="flex flex-col">
        <a href="/faculty/dashboard" class="nav-link" style="display:block;padding:10px 8px;text-decoration:none;color:#cbd5e1">Overview</a>
        <a href="/faculty/assignments" class="nav-link" style="display:block;padding:10px 8px;text-decoration:none;color:#cbd5e1">Assignments</a>
        <a href="/faculty/assignments/new" class="nav-link" style="display:block;padding:10px 8px;text-decoration:none;color:#cbd5e1">New Assignment</a>
        <a href="/faculty/lectures" class="nav-link" style="display:block;padding:10px 8px;text-decoration:none;color:#cbd5e1">Lectures</a>
        <a href="/faculty/dashboard#attendance" class="nav-link" style="display:block;padding:10px 8px;text-decoration:none;color:#cbd5e1">Attendance</a>
        <a href="/auth/logout" class="nav-link" style="display:block;padding:10px 8px;text-decoration:none;color:#cbd5e1;margin-top:8px">Logout</a>
      </nav>
    </aside>

    <main class="main">
      <div class="topbar bg-white rounded-lg shadow p-4 flex items-center justify-between">
        <div>
          <div class="text-2xl font-semibold text-gray-800"><%= user && user.name ? user.name : 'Faculty' %></div>
          <div class="text-sm text-gray-500">Dept: <%= user && user.department ? user.department : 'N/A' %></div>
        </div>
        <div><a class="px-3 py-2 rounded bg-blue-600 text-white" href="/faculty/assignments/new">Create Assignment</a></div>
      </div>

      <div class="card">
        <h3>Create Assignment</h3>
        <form id="createAssignment" style="margin-top:8px;display:flex;flex-direction:column;gap:8px;">
          <input name="title" placeholder="Title" required style="padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="subject" placeholder="Subject" required style="padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="department" placeholder="Department" value="<%= user && user.department ? user.department : '' %>" required style="padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="semester" placeholder="Semester" type="number" value="1" style="padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="dueDate" placeholder="Due Date (YYYY-MM-DD)" type="date" style="padding:8px;border:1px solid #ddd;border-radius:4px">
          <textarea name="description" placeholder="Description (optional)" style="padding:8px;border:1px solid #ddd;border-radius:4px"></textarea>
          <div style="text-align:right"><button type="button" id="createBtn" class="btn">Create</button></div>
        </form>
      </div>

      <div class="card">
        <h3>Create Lecture</h3>
        <form id="createLecture" style="margin-top:8px;display:flex;flex-direction:column;gap:8px;">
          <input name="title" placeholder="Topic / Title" required style="padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="subject" placeholder="Subject" required style="padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="department" placeholder="Department" value="<%= user && user.department ? user.department : '' %>" required style="padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="semester" placeholder="Semester" type="number" value="1" style="padding:8px;border:1px solid #ddd;border-radius:4px">
          <input name="date" type="date" required style="padding:8px;border:1px solid #ddd;border-radius:4px">
          <div style="display:flex;gap:8px;"><input name="startTime" placeholder="Start (HH:MM)" style="flex:1;padding:8px;border:1px solid #ddd;border-radius:4px"><input name="endTime" placeholder="End (HH:MM)" style="flex:1;padding:8px;border:1px solid #ddd;border-radius:4px"></div>
          <div style="text-align:right"><button type="button" id="createLectureBtn" class="btn">Create Lecture</button></div>
        </form>
      </div>

      <div class="card">
        <h3>Mark Attendance (by Lecture)</h3>
        <div style="margin-top:8px;">
          <% const lects = (typeof upcomingLectures !== 'undefined' && upcomingLectures) ? upcomingLectures : []; %>
          <% if(lects.length===0){ %>
            <div class="muted">No upcoming lectures to mark attendance.</div>
          <% } %>
          <% lects.forEach(l=>{ %>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #eef2f7">
              <div><strong><%= l.subject %></strong> <div class="muted"><%= l.date ? (new Date(l.date)).toISOString().slice(0,10) : '' %> &middot; <%= l.startTime || '' %></div></div>
              <div><button class="btn" onclick="openAttendance('<%= l._id %>','<%= l.department %>','<%= l.semester %>')">Mark</button></div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Attendance Modal -->
      <div id="attModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);align-items:center;justify-content:center">
        <div style="background:#fff;padding:16px;border-radius:8px;width:520px;max-width:96%">
          <h3>Mark Attendance</h3>
          <div id="attLectureInfo" class="muted"></div>
          <div id="attStudents" style="margin-top:12px;max-height:320px;overflow:auto"></div>
          <div style="text-align:right;margin-top:10px"><button id="saveAttendanceBtn" class="btn">Save</button> <button onclick="closeAttModal()" class="btn" style="background:#ef4444">Cancel</button></div>
        </div>
      </div>

      <div class="card">
        <h3>Recent Assignments</h3>
        <% const assignmentsData = (typeof assignments !== 'undefined' && assignments) ? assignments : [{id:1,title:'Lab 3', subject:'DBMS', dueDate:'2026-08-20'}]; %>
        <table>
          <thead><tr><th>Title</th><th>Subject</th><th>Due</th><th></th></tr></thead>
          <tbody>
            <% assignmentsData.forEach(a=>{ %>
              <tr>
                <td><%= a.title %></td>
                <td><%= a.subject %></td>
                <td><%= a.dueDate %></td>
                <td><a class="btn" href="/faculty/assignments/<%= a._id || a.id %>/submissions">Submissions</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="card">
        <h3>Recent Submissions</h3>
        <% const subsData = (typeof submissions !== 'undefined' && submissions) ? submissions : [{studentName:'Ravi', assignment:'Lab 3', status:'On-time'}]; %>
        <ul>
          <% subsData.forEach(s=>{ %>
            <li style="padding:6px 0;border-bottom:1px solid #eef2f7"><strong><%= s.studentName %></strong> — <span class="muted"><%= s.assignment %> (<%= s.status %>)</span></li>
          <% }) %>
        </ul>
      </div>
      
      <div class="card">
        <h3>Upcoming Lectures (7 days)</h3>
        <% const upLects = (typeof upcomingLectures !== 'undefined' && upcomingLectures) ? upcomingLectures : []; %>
        <% if(upLects.length===0){ %>
          <div class="muted">No lectures scheduled in the next 7 days.</div>
        <% } %>
        <% upLects.forEach(l=>{ %>
          <div style="padding:6px 0;border-bottom:1px solid #eef2f7"><strong><%= l.subject %></strong> — <span class="muted"><%= l.date ? (new Date(l.date)).toISOString().slice(0,10) : '' %> <%= l.startTime ? (' ' + l.startTime) : '' %></span><div class="muted">Topic: <%= l.title %></div></div>
        <% }) %>
      </div>

      <div class="card">
        <h3>My Subjects</h3>
        <% const subjList = (typeof subjects !== 'undefined' && subjects) ? subjects : []; %>
        <% if(subjList.length===0) { %>
          <div class="muted">No subjects found.</div>
        <% } %>
        <% subjList.forEach(s=>{ %>
          <div style="padding:6px 0;border-bottom:1px solid #eef2f7"><strong><%= s %></strong></div>
        <% }) %>
      </div>

      <div class="card">
        <h3>Upcoming Campus Events</h3>
        <% const upE = (typeof upcomingEvents !== 'undefined' && upcomingEvents) ? upcomingEvents : []; %>
        <% if(upE.length===0){ %>
          <div class="muted">No upcoming events.</div>
        <% } %>
        <% upE.forEach(ev=>{ %>
          <div style="padding:6px 0;border-bottom:1px solid #eef2f7"><strong><%= ev.title %></strong> — <span class="muted"><%= ev.eventDate ? (new Date(ev.eventDate)).toISOString().slice(0,10) : '' %></span></div>
        <% }) %>
      </div>
    </main>
  </div>
  <script>
    // highlight active nav link
    (function(){
      try{
        const path = window.location.pathname;
        document.querySelectorAll('.nav-link').forEach(a=>{
          if(a.getAttribute('href')===path || path.startsWith(a.getAttribute('href'))){
            a.style.background = '#0ea5a3'; a.style.color='#fff'; a.style.borderRadius='6px';
          }
        });
      }catch(e){}
    })();
    // ensure nav links navigate even if some other script stops default
    (function(){
      try{
        document.querySelectorAll('.nav-link').forEach(a=>{
          a.addEventListener('click', function(e){
            const href = a.getAttribute('href');
            if(!href) return;
            // if it's a hash for same-page, let it be
            if(href.startsWith('#')) return;
            // fallback navigation to bypass any preventDefault elsewhere
            setTimeout(()=>{ window.location.href = href; }, 10);
          });
        });
      }catch(e){}
    })();
    document.getElementById('createBtn').addEventListener('click', async function(){
      const form = document.getElementById('createAssignment');
      const data = {
        title: form.title.value.trim(),
        subject: form.subject.value.trim(),
        department: form.department.value.trim(),
        semester: parseInt(form.semester.value,10) || 1,
        dueDate: form.dueDate.value || null,
        description: form.description.value.trim()
      };
      if(!data.title || !data.subject || !data.department){ alert('Please fill required fields'); return; }
      try{
        const res = await fetch('/faculty/assignments/new', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
        if(res.ok){ alert('Assignment created'); window.location.reload(); } else { const txt = await res.text(); alert('Error: '+txt); }
      }catch(e){ console.error(e); alert('Network error'); }
    });

    document.getElementById('createLectureBtn').addEventListener('click', async function(){
      const form = document.getElementById('createLecture');
      const data = {
        title: form.title.value.trim(),
        subject: form.subject.value.trim(),
        department: form.department.value.trim(),
        semester: form.semester.value,
        date: form.date.value,
        startTime: form.startTime.value,
        endTime: form.endTime.value
      };
      if(!data.title || !data.subject) { alert('Please fill required fields'); return; }
      try{
        const res = await fetch('/faculty/lectures/new', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
        if(res.ok){ alert('Lecture created'); window.location.reload(); } else { const txt = await res.text(); alert('Error: '+txt); }
      }catch(e){ console.error(e); alert('Network error'); }
    });

    // Attendance modal interactions
    let currentLectureId = null;
    async function openAttendance(lectureId, dept, sem){
      currentLectureId = lectureId;
      document.getElementById('attLectureInfo').innerText = 'Lecture ID: ' + lectureId;
      document.getElementById('attStudents').innerHTML = 'Loading...';
      document.getElementById('attModal').style.display = 'flex';
      try{
        const res = await fetch('/faculty/lectures/'+lectureId+'/students');
        const j = await res.json(); if(!j.success){ document.getElementById('attStudents').innerText = 'Failed to load students'; return; }
        const students = j.students || [];
        const container = document.getElementById('attStudents'); container.innerHTML = '';
        students.forEach(s => {
          const row = document.createElement('div'); row.style.display='flex'; row.style.justifyContent='space-between'; row.style.alignItems='center'; row.style.padding='8px 0'; row.style.borderBottom='1px solid #eef2f7';
          row.dataset.id = s._id; // embed student id for reliable mapping when saving
          row.innerHTML = `<div><strong>${s.name}</strong><div class="muted">${s.rollNumber||''}</div></div>`;
          const ctrl = document.createElement('div');
          const presentBtn = document.createElement('button'); presentBtn.className='btn'; presentBtn.style.background='#10b981'; presentBtn.innerText='Present';
          const absentBtn = document.createElement('button'); absentBtn.className='btn'; absentBtn.style.background='#ef4444'; absentBtn.style.marginLeft='8px'; absentBtn.innerText='Absent';
          presentBtn.addEventListener('click', ()=>{ presentBtn.style.opacity='1'; absentBtn.style.opacity='0.5'; presentBtn.dataset.state='present'; absentBtn.dataset.state=''; row.dataset.status='Present'; });
          absentBtn.addEventListener('click', ()=>{ absentBtn.style.opacity='1'; presentBtn.style.opacity='0.5'; absentBtn.dataset.state='absent'; presentBtn.dataset.state=''; row.dataset.status='Absent'; });
          ctrl.appendChild(presentBtn); ctrl.appendChild(absentBtn); row.appendChild(ctrl);
          container.appendChild(row);
        });
      }catch(e){ console.error(e); document.getElementById('attStudents').innerText='Error'; }
    }

    function closeAttModal(){ document.getElementById('attModal').style.display='none'; currentLectureId=null; }

    document.getElementById('saveAttendanceBtn').addEventListener('click', async ()=>{
      if(!currentLectureId) return;
      const rows = Array.from(document.getElementById('attStudents').children);
      const finalRecords = rows.map(r => ({ student: r.dataset.id, status: r.dataset.status || 'Absent' }));
      try{
        const res = await fetch('/faculty/lectures/'+currentLectureId+'/attendance', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ records: finalRecords }) });
        const j = await res.json(); if(j.success){ alert('Attendance saved'); closeAttModal(); } else alert('Failed to save');
      }catch(e){ console.error(e); alert('Network error'); }
    });
  </script>
</body>
</html>
