<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>UniHub — Campus Dashboard</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    html,body,#root{height:100%}
    body{font-family:Segoe UI, Roboto, Arial, sans-serif;background:linear-gradient(180deg,#f8fafc,#eef2f7);color:#0f172a}
    .container{max-width:1200px;margin:36px auto;padding:24px}
    .nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}
    .logo{display:flex;align-items:center;gap:10px}
    .site-logo{height:36px;width:auto;display:inline-block}
    .logo-text{font-weight:700;color:#0f172a;font-size:18px}
    .nav-links a{margin-left:12px;text-decoration:none;color:#0f172a;padding:8px 12px;border-radius:8px}
    .nav-links a.cta{background:#0ea5a3;color:#fff}

    .hero{display:flex;gap:28px;align-items:center;background:linear-gradient(90deg,rgba(14,165,163,0.06),rgba(37,99,235,0.03));padding:28px;border-radius:12px}
    .hero-left{flex:1}
    h1{font-size:32px;line-height:1.05;margin-bottom:10px}
    p.lead{color:#475569;margin-bottom:16px;font-size:15px}
    .ctas a{display:inline-block;margin-right:12px;padding:10px 16px;border-radius:8px;text-decoration:none}
    .primary{background:#2563eb;color:#fff}
    .secondary{background:#fff;border:1px solid #e6eefb;color:#0f172a}

    .hero-right{width:420px;display:flex;justify-content:center}
    .card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}
    .card{background:#fff;padding:14px;border-radius:10px;box-shadow:0 6px 18px rgba(8,15,28,0.06)}
    .card h4{margin-bottom:8px}
    .muted{color:#64748b;font-size:14px}

    .features-2{display:flex;gap:12px;margin-top:22px}
    .feature-wide{flex:1;background:#fff;padding:16px;border-radius:10px;box-shadow:0 6px 18px rgba(8,15,28,0.04)}

    footer{margin-top:28px;color:#94a3b8;font-size:13px;text-align:center}
    @media(max-width:980px){.hero{flex-direction:column}.hero-right{width:100%}.card-grid{grid-template-columns:1fr}} 
  </style>
</head>
<body>
  <div class="container" id="root">
    <nav class="nav">
      <div class="logo"><img src="/logo.png" alt="UniHub" class="site-logo"><span class="logo-text">UniHub</span></div>
      <div class="nav-links">
        <a href="/auth/login">Login</a>
        <a href="/auth/register" class="cta">Register</a>
      </div>
    </nav>

    <section class="hero">
      <div class="hero-left">
        <h1>One place for campus life — assignments, attendance, lectures, placements.</h1>
        <p class="lead">UniHub connects students, faculty and admins with role-specific dashboards, real-time notifications and easy workflows for academic activities.</p>
        <div class="ctas">
          <a class="primary" href="/auth/register">Get Started</a>
          <a class="secondary" href="/auth/login">Sign In</a>
        </div>
        <div class="card-grid">
          <div class="card"><h4>Assignments</h4><div class="muted">Create, submit and grade with comments and deadlines.</div></div>
          <div class="card"><h4>Attendance</h4><div class="muted">Track per-subject attendance with visual summaries.</div></div>
          <div class="card"><h4>Lectures</h4><div class="muted">Daily timetable and lecture details with faculty info.</div></div>
        </div>
      </div>
      <div class="hero-right">
        <!-- simple SVG illustration -->
        <svg width="360" height="220" viewBox="0 0 360 220" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="g1" x1="0" x2="1">
              <stop stop-color="#60a5fa" offset="0"/>
              <stop stop-color="#34d399" offset="1"/>
            </linearGradient>
          </defs>
          <rect rx="12" width="360" height="220" fill="url(#g1)" opacity="0.12" />
          <g transform="translate(18,24)">
            <rect x="0" y="0" width="140" height="18" rx="4" fill="#fff" opacity="0.9"/>
            <rect x="0" y="30" width="320" height="12" rx="6" fill="#fff" opacity="0.9"/>
            <rect x="0" y="54" width="200" height="12" rx="6" fill="#fff" opacity="0.85"/>
            <circle cx="280" cy="80" r="28" fill="#fff" opacity="0.95"/>
            <rect x="0" y="90" width="320" height="80" rx="8" fill="#fff" opacity="0.9"/>
          </g>
        </svg>
      </div>
    </section>

    <section class="features-2">
      <div class="feature-wide">
        <h4>Placements & Careers</h4>
        <div class="muted">Companies post drives, students apply and track status; coordinators manage drives centrally.</div>
      </div>
      <div class="feature-wide">
        <h4>Events & Announcements</h4>
        <div class="muted">Create events, register attendees, and send announcements by department or campus-wide.</div>
      </div>
    </section>

    <section style="margin-top:26px;">
      <div style="display:flex;gap:18px;align-items:flex-start;flex-wrap:wrap">
        <div style="flex:1;min-width:300px;background:#fff;padding:18px;border-radius:10px;box-shadow:0 6px 18px rgba(8,15,28,0.04)">
          <h3>How it works</h3>
          <ol style="margin-top:10px;padding-left:18px;color:#475569">
            <li style="margin:8px 0">Register as student, faculty or admin and complete your profile.</li>
            <li style="margin:8px 0">Faculty create lectures and assignments; students submit and apply.</li>
            <li style="margin:8px 0">Coordinators manage events and placements; admins oversee campus workflows.</li>
          </ol>
        </div>

        <div style="flex:1;min-width:300px;background:#fff;padding:18px;border-radius:10px;box-shadow:0 6px 18px rgba(8,15,28,0.04)">
          <h3>Testimonials</h3>
          <div style="margin-top:10px;display:flex;flex-direction:column;gap:10px">
            <div style="padding:10px;border-radius:8px;background:#f8fafc">“UniHub made tracking attendance and submissions effortless — both for faculty and students.” — Asha, CSE</div>
            <div style="padding:10px;border-radius:8px;background:#f8fafc">“Placement drives are easier to manage; students apply directly through the portal.” — Raj, Coordinator</div>
            <div style="padding:10px;border-radius:8px;background:#f8fafc">“I get prompt notifications about events and deadlines now.” — Priya, Student</div>
          </div>
        </div>
      </div>
    </section>

    <section style="margin-top:26px;display:flex;gap:18px;flex-wrap:wrap">
      <div style="flex:1;min-width:420px;background:#fff;padding:18px;border-radius:10px;box-shadow:0 6px 18px rgba(8,15,28,0.04)">
        <h3>Frequently Asked Questions</h3>
        <div style="margin-top:10px;color:#475569">
          <strong>Q: Who can register?</strong>
          <div class="muted">Students, faculty, coordinators and admins — each gets role-specific features.</div>
          <strong style="display:block;margin-top:8px">Q: Can I export attendance reports?</strong>
          <div class="muted">Yes — admins and faculty can export CSV summaries for a date range.</div>
          <strong style="display:block;margin-top:8px">Q: How are notifications delivered?</strong>
          <div class="muted">In-app notifications are immediate; email integration can be enabled by admins.</div>
        </div>
      </div>

      <div style="width:360px;background:#fff;padding:18px;border-radius:10px;box-shadow:0 6px 18px rgba(8,15,28,0.04)">
        <h3>Contact & Newsletter</h3>
        <div class="muted" style="margin-bottom:10px">Reach out for support or request a demo.</div>
        <div style="margin-bottom:8px"><strong>Email</strong><div class="muted">support@unihub.example</div></div>
        <div style="margin-bottom:8px"><strong>Phone</strong><div class="muted">+1 (555) 123-4567</div></div>
        <form id="newsletter" style="margin-top:10px">
          <input id="nlEmail" type="email" placeholder="Your email" style="width:100%;padding:8px;border:1px solid #e6eefb;border-radius:6px;margin-bottom:8px">
          <div style="text-align:right"><button type="button" onclick="subscribe()" class="primary" style="border:none;padding:8px 12px;border-radius:6px">Subscribe</button></div>
        </form>
      </div>
    </section>

    <script>
      function subscribe(){
        var e = document.getElementById('nlEmail').value.trim();
        if(!e) return alert('Enter email');
        alert('Thanks — subscription simulated for ' + e);
        document.getElementById('newsletter').reset();
      }
    </script>

    <footer>
      © <%= new Date().getFullYear() %> UniHub — Built for educators and students.
    </footer>
  </div>
</body>
</html>
